        "z": "2bf9e411eebbc2c3",
        "name": "Bot Registration",
        "func": "let chatId = msg.payload.chatId;\nlet command = msg.payload.content;\nlet subscribers = global.get(\"telegramSubscribers\") || [];\n\nif (command === \"/start\") {\n    if (!subscribers.includes(chatId)) {\n        subscribers.push(chatId);\n        global.set(\"telegramSubscribers\", subscribers);\n    }\n    msg.payload.type = 'message';\n    msg.payload.content = \"Success! You will now receive a high temperature warning notification.\";\n    return msg;\n} \nelse if (command === \"/stop\") {\n    // Buang ID pengguna dari senarai memori Telegram\n    subscribers = subscribers.filter(id => id !== chatId);\n    global.set(\"telegramSubscribers\", subscribers);\n    \n    msg.payload.type = 'message';\n    msg.payload.content = \"Notifications stopped. Type /start to restart.\";\n    return msg;\n}\nreturn null;",
