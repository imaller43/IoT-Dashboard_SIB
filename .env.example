# Authentication (Clerk)
VITE_CLERK_PUBLISHABLE_KEY=your_clerk_publishable_key_here

# Real-Time Messaging (MQTT)
VITE_MQTT_BROKER_URL=wss://your_mqtt_broker_ip:port/mqtt
VITE_MQTT_USERNAME=your_mqtt_username
VITE_MQTT_PASSWORD=your_mqtt_password

# Historical Data (InfluxDB)
VITE_INFLUXDB_URL=http://your_influxdb_ip:8086
VITE_INFLUXDB_TOKEN=your_influxdb_token_here
VITE_INFLUXDB_ORG=your_influxdb_org_name
VITE_INFLUXDB_BUCKET=your_influxdb_bucket_name

# Notifications (Firebase)
VITE_FIREBASE_API_KEY=your_firebase_api_key
VITE_FIREBASE_AUTH_DOMAIN=your_firebase_auth_domain
VITE_FIREBASE_PROJECT_ID=your_firebase_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_firebase_storage_bucket
VITE_FIREBASE_MESSAGING_SENDER_ID=your_firebase_sender_id
VITE_FIREBASE_APP_ID=your_firebase_app_id
