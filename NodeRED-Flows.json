    {
        "id": "combined_logic_node",
        "type": "function",
        "z": "2bf9e411eebbc2c3",
        "name": "Switch & LED Logic",
        "func": "// 1. Simpan dan kemas kini bacaan dalam memori (Context)\nlet temp = context.get('suhu_semasa') || 25.0;\nlet sw = context.get('suis_semasa');\nif (sw === undefined) { sw = 1; }\n\nif (msg.topic === \"sapura/bilik1/temperature\") {\n    temp = parseFloat(msg.payload);\n    context.set('suhu_semasa', temp);\n} else {\n    sw = parseInt(msg.payload);\n    context.set('suis_semasa', sw);\n}\n\n// 2. Tentukan status keperluan kelipan (Rules)\nlet needGreenBlink = (sw === 1 && temp < 27);\nlet needWarningBlink = (temp > 24.5);\nlet anyBlinkNeeded = (needGreenBlink || needWarningBlink);\n\n// SIMPAN STATUS INI SUPAYA JAM RANDIK BOLEH BACA YANG TERKINI\ncontext.set(\"needGreenBlink\", needGreenBlink);\ncontext.set(\"needWarningBlink\", needWarningBlink);\n\n// 3. Status statik\nlet redCmd = (sw === 0 || temp >= 27) ? 1 : 0;\nlet msgInterrupt2 = { payload: (temp >= 27) ? \"0\" : \"1\" };\n\nnode.send([\n    { payload: redCmd },\n    !needGreenBlink ? { payload: 0 } : null,\n    !needWarningBlink ? { payload: 0 } : null,\n    msgInterrupt2\n]);\n\n// 5. Pengurusan Jam Randik\nlet timer = context.get(\"masterTimer\");\nlet isBlinking = context.get(\"isBlinking\") || false;\nlet blinkState = context.get(\"blinkState\") || 0;\n\nif (anyBlinkNeeded) {\n    if (!isBlinking) {\n        isBlinking = true;\n        context.set(\"isBlinking\", isBlinking);\n\n        timer = setInterval(function () {\n            // BACA STATUS TERKINI DARI MEMORI (Membaiki ralat kelipan hijau tidak berhenti)\n            let doGreen = context.get(\"needGreenBlink\");\n            let doWarn = context.get(\"needWarningBlink\");\n\n            blinkState = (blinkState === 0) ? 1 : 0;\n            context.set(\"blinkState\", blinkState);\n\n            let greenOut = doGreen ? { payload: blinkState } : null;\n            let warnOut = doWarn ? { payload: blinkState } : null;\n\n            node.send([null, greenOut, warnOut, null]);\n        }, 500);\n\n        context.set(\"masterTimer\", timer);\n    }\n} else {\n    if (isBlinking) {\n        clearInterval(timer);\n        context.set(\"masterTimer\", null);\n        context.set(\"isBlinking\", false);\n    }\n}\n\nnode.on(\"close\", function () {\n    let activeTimer = context.get(\"masterTimer\");\n    if (activeTimer) {\n        clearInterval(activeTimer);\n        context.set(\"masterTimer\", null);\n        context.set(\"isBlinking\", false);\n    }\n});\n\nreturn null;",
