    {
        "id": "combined_notification_node",
        "type": "function",
        "z": "2bf9e411eebbc2c3",
        "name": "Notification Logic",
        "func": "let currentTemp = parseFloat(msg.payload);\nlet wasHigh = context.get('wasHigh') || false;\n\n// 1. Logik semakan suhu (Hanya hantar sekali bila suhu naik melepasi 27)\nif (currentTemp > 25) {\n    if (!wasHigh) {\n        context.set('wasHigh', true); // Kunci supaya tak hantar bertubi-tubi\n\n        // --- FIREBASE WEB PUSH (OUTPUT 1) ---\n        let fcmTokens = global.get('fcm_tokens') || [];\n        let firebaseMsgs = null;\n        \n        if (fcmTokens.length > 0) {\n            let tempFirebase = [];\n            for (let i = 0; i < fcmTokens.length; i++) {\n                tempFirebase.push({\n                    payload: {\n                        token: fcmTokens[i],\n                        notification: {\n                            title: \"ALERT!!! HIGH TEMPERATURE\",\n                            body: \"DESIGN ROOM TEMPERATURE IS \" + currentTemp + \"°C. \\nPLEASE DO THE INSPECTION.\"\n                        }\n                    }\n                });\n            }\n            firebaseMsgs = tempFirebase;\n        } else {\n            node.warn(\"No Firebase device is active.\");\n        }\n\n        // --- TELEGRAM BOT (OUTPUT 2) ---\n        let tgSubscribers = global.get(\"telegramSubscribers\") || [];\n        let telegramMsgs = null;\n\n        if (tgSubscribers.length > 0) {\n            let tempTelegram = [];\n            let alertMessage = \"ALERT!!!! HIGH TEMPERATURE \\nDESIGN ROOM TEMPERATURE IS \" + currentTemp + \"°C. \\nPLEASE DO THE INSPECTION.\";\n            \n            for (let i = 0; i < tgSubscribers.length; i++) {\n                tempTelegram.push({\n                    payload: {\n                        chatId: tgSubscribers[i],\n                        type: 'message',\n                        content: alertMessage\n                    }\n                });\n            }\n            telegramMsgs = tempTelegram;\n        }\n\n        // Hantar kedua-duanya serentak melalui Output 1 dan Output 2\n        return [firebaseMsgs, telegramMsgs];\n    } else {\n        // Suhu masih tinggi (dah pernah hantar amaran), abaikan.\n        return null;\n    }\n} else {\n    // Suhu dah kembali normal (< 27). Buka kunci untuk amaran seterusnya.\n    context.set('wasHigh', false);\n    return null;\n}",
