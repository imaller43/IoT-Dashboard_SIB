    {
        "id": "combined_fcm_manager",
        "type": "function",
        "z": "2bf9e411eebbc2c3",
        "name": "Token Management",
        "func": "// Ambil senarai token dari memori\nlet tokens = global.get(\"fcm_tokens\") || [];\nlet tokenPayload = msg.payload.toString();\n\nif (!tokenPayload) return null;\n\n// 1. Logik Mendaftar Token Baharu\nif (msg.topic === \"sapura/fcm/register\") {\n    if (tokens.indexOf(tokenPayload) === -1) {\n        tokens.push(tokenPayload);\n        global.set('fcm_tokens', tokens);\n        node.warn(\"FCM Token has been Registered. Current value: \" + tokens.length);\n    }\n}\n// 2. Logik Membuang Token\nelse if (msg.topic === \"sapura/fcm/unregister\") {\n    let saizAsal = tokens.length;\n    tokens = tokens.filter(t => t !== tokenPayload);\n    \n    // Hanya kemas kini jika ada token yang berjaya dibuang\n    if (tokens.length < saizAsal) {\n        global.set(\"fcm_tokens\", tokens);\n        node.warn(\"FCM Token has been removed. Current Value: \" + tokens.length);\n    }\n}\n\nreturn null;",
