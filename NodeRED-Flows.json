    {
        "id": "2cfd2c8f881cbbf1",
        "type": "function",
        "z": "2bf9e411eebbc2c3",
        "name": "Split JSON Data",
        "func": "// Parse JSON jika ia masih dalam bentuk string\nlet data = typeof msg.payload === 'string' ? JSON.parse(msg.payload) : msg.payload;\n\n// Sediakan 3 mesej berasingan dengan TOPIK ASAL supaya flow lama tak terganggu\nlet msgTemp = { payload: data.temperature, topic: \"sapura/bilik1/temperature\" };\nlet msgHum = { payload: data.humidity, topic: \"sapura/bilik1/humidity\" };\nlet msgLight = { payload: data.light_density, topic: \"sapura/bilik1/ldr\" };\n\n// Pecahkan kepada 3 port output\nreturn [msgTemp, msgHum, msgLight];",
        "outputs": 3,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
