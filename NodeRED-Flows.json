    {
        "id": "d0aa09bc64ac4035",
        "type": "function",
        "z": "2bf9e411eebbc2c3",
        "name": "Brightness Logic",
        "func": "let overrideState = context.get('overrideLight') || 0;\n// 1. Panggil memori bacaan LDR (PWM) yang terakhir\nlet lastPwmValue = context.get('lastPwm') || 0;\n\nif (msg.topic === \"sapura/bilik1/switch/light\") {\n\n    overrideState = parseInt(msg.payload);\n    context.set('overrideLight', overrideState);\n\n    if (overrideState === 1) {\n        return { payload: 100 };\n    } else {\n        // 2. Bila suis ditekan OFF, serta-merta hantar memori PWM terakhir ke lampu!\n        return { payload: lastPwmValue };\n    }\n\n} else {\n\n    // --- KIRAAN LDR ---\n    let ldr_ms = parseFloat(msg.payload);\n    let min_ms = 35;\n    let max_ms = 3000;\n\n    if (ldr_ms < min_ms) ldr_ms = min_ms;\n    if (ldr_ms > max_ms) ldr_ms = max_ms;\n\n    let pwm_value = ((ldr_ms - min_ms) / (max_ms - min_ms)) * 100;\n    pwm_value = Math.round(pwm_value);\n\n    // 3. Sentiasa kemas kini memori lastPwm supaya kita tak ketinggalan bacaan terbaru\n    context.set('lastPwm', pwm_value);\n\n    // 4. Tapisan Akhir: Hantar atau tak?\n    if (overrideState === 1) {\n        // Kalau manual sedang ON, kita cuma simpan memori tadi dalam diam. Jangan hantar ke lampu.\n        return null;\n    } else {\n        // Kalau Auto (Manual OFF), hantar bacaan seperti biasa\n        msg.payload = pwm_value;\n        return msg;\n    }\n}",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 590,
        "y": 380,
        "wires": [
            [
                "b9506871eb4cfc59"
            ]
        ]
    },
